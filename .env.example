# Copy to .env and fill in only the values you use. Never commit .env.

# MVP registry contains only ZGSZ. Phase 2 will add a domestic list and
# a user subscription. See src/airport_monitor/airports.py.
AIRPORT_ICAO=ZGSZ

# WGS84 box around Shenzhen Bao'an, tuned to the three runway pairs.
# ARP (CAAC AIP): N22°38.3' E113°48.7'. Area is about 0.017 sq deg (1 OpenSky credit).
# The original sketch (lat 22.55–22.70, lon 113.75–113.95) also covers the field
# but extends much farther east into the city. Override here if you want that.
OPENSKY_LAMIN=22.58
OPENSKY_LAMAX=22.70
OPENSKY_LOMIN=113.74
OPENSKY_LOMAX=113.88

# Seconds between polls. Minimum is 10 (anonymous OpenSky snapshot resolution).
# Daily credit budgets: anonymous 400, standard account 4000, active feeder 8000.
# One ZGSZ poll costs 1 credit, so:
#   15s  ≈ 5760/day  (anonymous budget lasts ~1.7h; standard account ~17h)
#   30s  ≈ 2880/day  (fits a standard account for 24h)
#   240s ≈ 360/day   (fits anonymous for 24h, with a little headroom)
POLL_INTERVAL_SECONDS=15

# Consecutive polls the new on_ground value must hold before an alert.
DEBOUNCE_SAMPLES=2

# Forget an icao24 after this many seconds without a fresh sample.
TRACK_TTL_SECONDS=900

# Optional OAuth2 client credentials from the OpenSky account page (API client).
# Leave both empty for anonymous access. Basic username/password auth no longer works.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Primary alert channel. The monitor POSTs the JSON event here.
# ALERT_WEBHOOK_URL=http://127.0.0.1:8791/hooks/zgsz
ALERT_WEBHOOK_URL=

# Email adapter. Mail is sent only when ALERT_EMAIL_TO, SMTP_HOST, and a From
# address (SMTP_FROM or SMTP_USER) are all set. Otherwise the adapter logs the
# payload and does not open a connection. SMTP_USER also requires SMTP_PASSWORD.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20

# Uncomment only for local tests. Allows POLL_INTERVAL_SECONDS below 10.
# OPENSKY_ALLOW_FAST_POLL=1

# Optional endpoint overrides.
# OPENSKY_BASE_URL=https://opensky-network.org/api
# OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
